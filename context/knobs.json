    "LOOKAHEAD_INNER_ITEMS": {
      "axis": "rollout",
      "semantic": true
    },
    "LOOKAHEAD_SELECTION_MODE": {
      "axis": "rollout",
      "semantic": true
    },
    "LOOKAHEAD_TIME_RESERVE_SECONDS": {
      "axis": "timing",
      "semantic": true
    },
    "LOOKAHEAD_TOP_K": {
      "axis": "rollout",
      "semantic": true
    },
    "MAX_POOL_ITEMS_EVALUATED": {
      "axis": "item",
      "semantic": true
    },
    "NEDO_CANDIDATE_AUDIT": {
      "axis": "diagnostic",
      "semantic": false
    },
    "NEDO_POLICY_TRACE_PATH": {
      "axis": "diagnostic",
