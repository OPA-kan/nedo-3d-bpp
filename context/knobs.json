{
  "version": 1,
  "contract": {
    "purpose": "Canonical registry of every environment knob agent/agent.py reads. One source, so the fingerprint's component list, the axis registry and the documentation cannot drift apart -- they did: the fingerprint tracked 26 of 47 knobs and four of those names did not exist, so a merge that added three knobs passed it unchanged.",
    "rule": "semantic=true means the knob can change what the agent does, so it belongs in the optimizer fingerprint. semantic=false is diagnostics/telemetry only. A knob absent from this file fails tests/test_knob_registry.py -- adding an env read to agent.py requires registering it here and deciding its axis.",
    "projection_warning": "A fingerprint sees only P(Theta), the registered projection. P(Theta)=P(Theta') does not imply Theta=Theta'. This registry is what keeps the projection total over env knobs; it does NOT cover source literals such as the Ranker weights, which remain unregistered because they are not settable."
  },
  "knobs": {
    "ANCHOR_DEEP_PASS_ATTEMPTS": {
      "axis": "anchor",
      "semantic": true
    },
    "ANCHOR_FIRST_PASS_ATTEMPTS": {
      "axis": "anchor",
      "semantic": true
    },
    "ANCHOR_GENERATOR_MODE": {
      "axis": "anchor",
      "semantic": true
    },
    "CROSS_STEP_INCUMBENT_MODE": {
      "axis": "fallback",
      "semantic": true
    },
    "CROSS_STEP_INCUMBENT_PER_ITEM": {
      "axis": "fallback",
      "semantic": true
    },
    "DPOR_MAX_ALTERNATE_ATTEMPTS": {
      "axis": "anchor",
      "semantic": true
    },
    "ITEM_COVERAGE_MODE": {
      "axis": "item",
      "semantic": true
    },
    "LIVE_SEARCH_INTERLEAVE": {
      "axis": "anchor",
      "semantic": true
    },
    "LOOKAHEAD_DISCOUNT": {
      "axis": "rollout",
      "semantic": true
    },
    "LOOKAHEAD_INNER_ITEMS": {
      "axis": "rollout",
      "semantic": true
    },
    "LOOKAHEAD_SELECTION_MODE": {
      "axis": "rollout",
      "semantic": true
    },
    "LOOKAHEAD_TIME_RESERVE_SECONDS": {
      "axis": "timing",
      "semantic": true
    },
    "LOOKAHEAD_TOP_K": {
      "axis": "rollout",
      "semantic": true
    },
    "MAX_POOL_ITEMS_EVALUATED": {
      "axis": "item",
      "semantic": true
    },
    "NEDO_CANDIDATE_AUDIT": {
      "axis": "diagnostic",
      "semantic": false
    },
    "NEDO_POLICY_TRACE_PATH": {
      "axis": "diagnostic",
      "semantic": false
    },
    "OFFLINE_DRY_RUN_ATTEMPTS_PER_ITEM": {
      "axis": "order",
      "semantic": true
    },
    "OFFLINE_FILL_WEIGHT": {
      "axis": "order",
      "semantic": false,
      "note": "Dead, not diagnostic. It is read only as a default argument of DryRunResult.weighted_score (agent.py:941), which has no callers; offline selection is the lexicographic rank_key. Registering it as semantic was my error: it made the fingerprint report a component move for a knob that provably cannot change behaviour. tests/test_knob_registry.py pins that weighted_score stays uncalled, so wiring it up fails a test instead of silently making this knob semantic again."
    },
    "OFFLINE_MAX_EVALUATIONS": {
      "axis": "order",
      "semantic": true
    },
    "OFFLINE_PAIR_MACRO_BUDGET_SECONDS": {
      "axis": "order",
      "semantic": true
    },
    "OFFLINE_SEARCH_BUDGET_SECONDS": {
      "axis": "timing",
      "semantic": true
    },
    "OFFLINE_STABILITY_WEIGHT": {
      "axis": "order",
      "semantic": false,
      "note": "Dead for the same reason as OFFLINE_FILL_WEIGHT: the only read is a default argument of the uncalled DryRunResult.weighted_score. Note that stability does reach selection, but through rank_key's stability_proxy element, which this knob does not weight."
    },
    "POLICY_ATTEMPT_BUDGET": {
