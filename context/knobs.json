    "OFFLINE_BUDGET_MODE": {
      "axis": "order",
      "semantic": true
    },
    "OFFLINE_DRY_RUN_ATTEMPTS_PER_ITEM": {
      "axis": "order",
      "semantic": true
    },
    "OFFLINE_FILL_WEIGHT": {
      "axis": "order",
      "semantic": false,
      "note": "INERT. Feeds only DryRunResult.weighted_score (agent.py:941), which has no call sites anywhere in the repository. The offline order search accepts a neighbour on DryRunResult.rank_key (agent.py:6350), a lexicographic tuple that does not consult either weight. Verified by ablation: 0.65/0.35, 0.0/1.0 and 99.0/-99.0 all give behaviour_sha256 a92092c2272df53636fe3b84ac75a9ca7cd6eaefe42c44c7718bb1bdff292b70. Do not tune this expecting an effect; change rank_key instead."
    },
    "OFFLINE_ILS_KICK_STRENGTH": {
