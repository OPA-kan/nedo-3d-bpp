{
  "version": 1,
  "contract": {
    "purpose": "Canonical registry of every environment knob agent/agent.py reads. One source, so the fingerprint's component list, the axis registry and the documentation cannot drift apart -- they did: the fingerprint tracked 26 of 47 knobs and four of those names did not exist, so a merge that added three knobs passed it unchanged.",
    "rule": "semantic=true means the knob can change what the agent does, so it belongs in the optimizer fingerprint. semantic=false keeps it out of the fingerprint, and covers two different reasons: diagnostics/telemetry, and knobs that are parsed but INERT because nothing reads the value they feed. Inert knobs carry a `note` saying so -- they are not telemetry, and the note is what stops the next reader from tuning them. A knob absent from this file fails tests/test_knob_registry.py -- adding an env read to agent.py requires registering it here and deciding its axis.",
    "projection_warning": "A fingerprint sees only P(Theta), the registered projection. P(Theta)=P(Theta') does not imply Theta=Theta'. This registry is what keeps the projection total over env knobs; it does NOT cover source literals such as the Ranker weights, which remain unregistered because they are not settable."
  },
  "knobs": {
    "ANCHOR_COMPONENT_ORDER": {
      "axis": "anchor",
      "semantic": true
    },
    "ANCHOR_DEEP_PASS_ATTEMPTS": {
      "axis": "anchor",
      "semantic": true
    },
    "ANCHOR_FIRST_PASS_ATTEMPTS": {
      "axis": "anchor",
      "semantic": true
    },
    "ANCHOR_GENERATOR_MODE": {
