      "axis": "candidate_rank",
      "semantic": true
    },
    "BOARD_FLATNESS_TOLERANCE": {
      "axis": "candidate_rank",
      "semantic": true
    },
    "BOARD_PROBE_SHAPES": {
      "axis": "candidate_rank",
      "semantic": true
    },
    "BOARD_SITE_CAP": {
      "axis": "candidate_rank",
      "semantic": true
    },
    "CROSS_STEP_INCUMBENT_MODE": {
      "axis": "fallback",
      "semantic": true
    },
    "CROSS_STEP_INCUMBENT_PER_ITEM": {
      "axis": "fallback",
      "semantic": true
    },
    "DPOR_MAX_ALTERNATE_ATTEMPTS": {
